# Production build (VPS): the web app and the API share the pretika.in origin, so
# use RELATIVE same-origin URLs (/api, /uploads, /thumbnail, /hubs) — zero CORS.
# nginx on the host reverse-proxies those paths to the API container.
# Empty value is intentional (see BASE_URL logic in src/lib/constants.js).
VITE_API_BASE_URL=

# Razorpay live publishable key (safe for the browser).
VITE_RAZORPAY_KEY_ID=rzp_live_TFod54nPpduX79
